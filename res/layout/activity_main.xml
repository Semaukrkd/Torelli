<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Діагностика Torelli T3"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etMacAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="MAC-адреса Bluetooth (напр. 00:11:22:33:44:55)"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAA"
            android:backgroundTint="#0088FF"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Підключитися"
            android:backgroundTint="#0088FF"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Статус: Не підключено"
            android:textColor="#FFCC00"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />

        <!-- Картка телеметрії -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvRpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Оберти: --- об/хв"
                android:textColor="#00FF66"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvGasPress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Тиск газу: --- бар"
                android:textColor="#00E5FF"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvMapPress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Тиск MAP: --- бар"
                android:textColor="#00E5FF"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTGas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Темп. газу: --- °C"
                android:textColor="#FF9100"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTReducer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Темп. редуктора: --- °C"
                android:textColor="#FF3D00"
                android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

